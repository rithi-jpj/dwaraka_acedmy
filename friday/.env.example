# FRIDAY AI Assistant - Environment Configuration
# Copy this file to .env and adjust values

# --- Application ---
APP_NAME="FRIDAY"
APP_VERSION="1.0.0"
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

# --- Server ---
HOST=0.0.0.0
PORT=8477
WORKERS=1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8477

# --- Database ---
# SQLite (default)
DATABASE_URL=sqlite+aiosqlite:///./data/friday.db
# PostgreSQL (production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/friday

# --- AI Providers ---
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-opus-20240229

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-pro

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# LM Studio (local)
LM_STUDIO_BASE_URL=http://localhost:1234

# Auto-select best available provider
PREFERRED_PROVIDER=auto

# --- Voice ---
STT_ENGINE=whisper        # whisper, faster_whisper, vosk
TTS_ENGINE=edge           # edge, piper, kokoro, pyttsx3
TTS_VOICE=en-US-AriaNeural
WAKE_WORDS=friday,hey friday

# --- Memory ---
MEMORY_BACKEND=sqlite
EMBEDDING_MODEL=all-MiniLM-L6-v2
MAX_MEMORY_CONTEXT=20

# --- Vision ---
VISION_ENABLED=true
OCR_LANGUAGE=eng
WEBCAM_DEVICE=0

# --- Security ---
# CHANGE THIS IN PRODUCTION - Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-secure-random-string-in-production
TOKEN_EXPIRY_HOURS=24

# --- Paths ---
DATA_DIR=./data
LOGS_DIR=./logs
TEMP_DIR=./temp
MODELS_DIR=./models
